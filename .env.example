# このファイルを .env にコピーして、自分の値に書き換える（第4回 04 の 1-1）。
# .env は絶対に Git にコミットしない（.gitignore で除外済み）。
# 無ければ app/config.py の既定値で動く。

# 自分の受講者 ID ＝ IAM ユーザー名（小文字の 名前-2610。例: yamada-2610）。AWS リソース名とログの絞り込みに使う
STUDENT_ID=unset

# local / aws
APP_ENV=local

# 画面の上に出す名前
APP_NAME=AI実践研修 エージェント

LOG_LEVEL=INFO

# 鍵（第4回 04 の 1-4）。手元ではここに書く。AWS では Secrets Manager から読むので、この行は要らない
DEMO_API_KEY=sk-demo-local-0000

# --- 第6回：会話履歴 ---
# 履歴の置き場（DynamoDB のテーブル名）。sam deploy の Outputs の ConversationTableName をそのまま書く（第6回 03 の 2-3）。
# 空なら履歴なし（第5回と同じ1問1答）
CONVERSATION_TABLE=
# モデルに送る過去の発言の上限（件数）。1往復 ＝ 2件。第6回 03 の 3-2 で 4 にして実験する
MAX_HISTORY_MESSAGES=20

# --- 第7回：tool とターン ---
# 1回の発話でモデルに聞いてよい回数の上限。tool を1回使うと1ターン増える（第7回 02 の 4-3 で 2 にして実験する）
MAX_AGENT_TURNS=5
# 1回の応答で作らせる最大トークン数。上限であって、短く答えさせる指示ではない（第7回 04 の 1-5 で 100 にして確かめる）
MAX_TOKENS=1024
